# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored — never commit real secrets.
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# Local development (default): SQLite, zero setup.
DATABASE_URL="file:./dev.db"

# Production: switch with `npm run use:postgres`, then use a Postgres URL:
# DATABASE_URL="postgresql://user:password@host:5432/chandan_mentorship?schema=public"


# --- Site --------------------------------------------------------------------
# Used for canonical URLs, Open Graph tags and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Admin -------------------------------------------------------------------
# Read by `npm run db:seed` to create your admin account.
ADMIN_EMAIL="banawadechandan@gmail.com"
ADMIN_PASSWORD="change-this-to-something-strong"

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""


# --- Payments (Razorpay) -----------------------------------------------------
# LEAVE BLANK to run the clearly-labelled mock payment flow.
# Set BOTH values to switch the whole app to live Razorpay checkout.
# The secret is server-only and is never sent to the browser.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""


# --- Meetings ----------------------------------------------------------------
# Optional: a permanent Google Meet / Zoom room reused for every session.
# Leave blank and the confirmation says the link will be emailed.
MEETING_STATIC_LINK=""
ZOOM_STATIC_LINK=""

# For real per-booking Google Meet links, add these and implement the Calendar
# call in src/lib/meeting.ts (the integration point is marked in the file).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""


# --- Email -------------------------------------------------------------------
# Leave blank and notifications are written to the database + server console,
# viewable at /admin/notifications. Set a key to send real email.
RESEND_API_KEY=""
MAIL_FROM="Chandan Banawade <bookings@yourdomain.com>"
